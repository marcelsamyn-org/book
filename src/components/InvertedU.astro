---
/**
 * Seery, Holman and Silver's Figure 1 for "Post-Traumatic Growth": four
 * well-being outcomes against cumulative lifetime adversity, plotted from the
 * coefficients in the paper's Table 2. Aliases: inverted U, U-curve, adversity,
 * Seery, lifetime adversity, resilience.
 */

import {
  adversityOutcomes,
  invertedUBox,
  invertedUEyebrow,
  invertedUXAxis,
  invertedUXTicks,
  invertedUYAxis,
  invertedUYTicks,
  outcomeAt,
  xHigh,
} from "./invertedU.js";
import { curveFigureSvg } from "./shapeFigure.js";

interface Props {
  /** The study behind the curves: who was measured, how many, and when. */
  readonly caption: string;
  readonly alt: string;
}

const { caption, alt } = Astro.props;
const svg = curveFigureSvg({
  series: adversityOutcomes.map((outcome) => ({
    key: outcome.key,
    label: outcome.label,
    at: (x: number) => outcomeAt(outcome, x),
    emphasis: outcome.emphasis === true,
  })),
  box: invertedUBox,
  xTicks: [...invertedUXTicks],
  yTicks: [...invertedUYTicks],
  xMin: 0,
  xMax: xHigh,
  xAxis: invertedUXAxis,
  yAxis: invertedUYAxis,
  alt,
});
---

<figure class="figure figure-shape">
  <span class="figure-eyebrow">{invertedUEyebrow}</span>
  <div class="figure-plot" set:html={svg} />
  <figcaption class="figure-caption">{caption}</figcaption>
</figure>

---
/**
 * The inverted U for "Post-Traumatic Growth", on the scale Seery, Holman and
 * Silver measured: lifetime adverse events against life satisfaction. Aliases:
 * inverted U, U-curve, adversity, Seery, lifetime adversity.
 */

import {
  invertedU,
  invertedUBox,
  invertedUEyebrow,
  invertedUMarks,
  invertedUTicks,
  invertedUXAxis,
  invertedUYAxis,
  maxEvents,
} from "./invertedU.js";
import { shapeFigureSvg } from "./shapeFigure.js";

interface Props {
  /** The study behind the curve: who was measured, how many, and when. */
  readonly caption: string;
  readonly alt: string;
}

const { caption, alt } = Astro.props;
const svg = shapeFigureSvg({
  shape: invertedU,
  marks: invertedUMarks,
  box: invertedUBox,
  xTicks: invertedUTicks,
  xMax: maxEvents,
  xAxis: invertedUXAxis,
  yAxis: invertedUYAxis,
  alt,
});
---

<figure class="figure figure-shape">
  <span class="figure-eyebrow">{invertedUEyebrow}</span>
  <div class="figure-plot" set:html={svg} />
  <figcaption class="figure-caption">{caption}</figcaption>
</figure>

---
/**
 * The story line diagram: one row per idea, a dot wherever the book touches
 * it, and a line from its first mention to its payoff. The x-axis is word
 * position, labelled with the book's parts and chapters.
 */
import type { Band, ResolvedMention, Storyline } from "../storyline/resolve.js";

interface Props {
  storyline: Storyline;
}

const { storyline } = Astro.props;
const { totalWords, parts, chapters, threads } = storyline;

const LABEL_W = 290;
const PLOT_W = 1000;
const PAD_R = 16;
const ROW_H = 24;
const BAND_H = 20;
const HEADER_H = BAND_H * 2 + 14;
const PAD_B = 12;
const WIDTH = LABEL_W + PLOT_W + PAD_R;
const PLOT_H = threads.length * ROW_H;
const HEIGHT = HEADER_H + PLOT_H + PAD_B;
const CHAR_W = 5.4;

const x = (position: number): number => LABEL_W + (position / totalWords) * PLOT_W;
const rowY = (i: number): number => HEADER_H + i * ROW_H + ROW_H / 2;
const pct = (position: number): string => `${Math.round((position / totalWords) * 100)}%`;
const words = (n: number): string => n.toLocaleString("en-US");

const shortTitle = (band: Band): string => {
  const [head, tail] = band.title.split(/:\s*/, 2);
  if (band.level === 1) return tail ?? band.title;
  return head ?? band.title;
};

const fitLabel = (band: Band, label: string): string | null => {
  const room = Math.floor((x(band.end) - x(band.start) - 8) / CHAR_W);
  if (room < 3) return null;
  return label.length <= room ? label : `${label.slice(0, room - 1)}…`;
};

const KIND_LABEL: Record<ResolvedMention["kind"], string> = {
  plant: "Planted",
  use: "Used",
  explain: "Explained",
  payoff: "Payoff",
};

const describe = (m: ResolvedMention): string => {
  if (m.early) return "Used before it is explained";
  if (m.afterPayoff) return `Callback (${KIND_LABEL[m.kind].toLowerCase()})`;
  return KIND_LABEL[m.kind];
};

const sectionPath = (m: ResolvedMention): string => m.section.path.join(" › ");

// Tooltip data, indexed by the order dots are rendered.
const tips: Array<{
  thread: string;
  label: string;
  early: boolean;
  section: string;
  quote: string;
  note: string;
  position: string;
}> = [];
const rows = threads.map((thread, i) => ({
  thread,
  y: rowY(i),
  dots: thread.mentions.map((m) => {
    tips.push({
      thread: thread.title,
      label: describe(m),
      early: m.early,
      section: sectionPath(m),
      quote: m.quote,
      note: m.note,
      position: `${words(m.position)} words in (${pct(m.position)})`,
    });
    return { m, tip: tips.length - 1 };
  }),
}));

const dotClass = (m: ResolvedMention): string => {
  const classes = ["sl-dot", `sl-${m.kind}`];
  if (m.afterPayoff) classes.push("sl-after");
  if (m.early) classes.push("sl-early");
  return classes.join(" ");
};

const earlyMentions = threads.flatMap((t) =>
  t.mentions.filter((m) => m.early).map((m) => ({ thread: t, m })),
);
const owed = threads.filter((t) => t.owed);
const coldOpens = threads.filter((t) => t.coldOpen);

const mentionOf = (t: (typeof threads)[number], kind: ResolvedMention["kind"]) =>
  t.mentions.find((m) => m.kind === kind);
const explainedIn = (t: (typeof threads)[number]): string =>
  (mentionOf(t, "explain") ?? mentionOf(t, "payoff"))?.section.title ?? "—";
---

<section class="sl">
  <div class="sl-controls">
    <div class="sl-legend" aria-label="Legend">
      <span><svg width="12" height="12" viewBox="-6 -6 12 12"><circle r="3.4" class="sl-dot sl-plant" /></svg> planted</span>
      <span><svg width="12" height="12" viewBox="-6 -6 12 12"><circle r="2.8" class="sl-dot sl-use" /></svg> used</span>
      <span><svg width="12" height="12" viewBox="-6 -6 12 12"><circle r="4.4" class="sl-dot sl-explain" /></svg> explained</span>
      <span><svg width="12" height="12" viewBox="-6 -6 12 12"><path d="M0,-5 L5,0 L0,5 L-5,0 Z" class="sl-dot sl-payoff" /></svg> payoff</span>
      <span><svg width="12" height="12" viewBox="-6 -6 12 12"><circle r="2.8" class="sl-dot sl-use sl-after" /></svg> callback</span>
      <span><svg width="12" height="12" viewBox="-6 -6 12 12"><circle r="2.8" class="sl-dot sl-use sl-early" /></svg> used before explained</span>
      <span><svg width="26" height="12" viewBox="0 0 26 12"><line x1="1" y1="6" x2="25" y2="6" class="sl-arc sl-arc-pre" /></svg> waiting for an explanation</span>
      <span><svg width="26" height="12" viewBox="0 0 26 12"><line x1="1" y1="6" x2="25" y2="6" class="sl-arc sl-arc-main" /></svg> waiting for the payoff</span>
      <span><svg width="26" height="12" viewBox="0 0 26 12"><line x1="1" y1="6" x2="25" y2="6" class="sl-arc sl-arc-main sl-arc-open" /></svg> in play, nothing promised</span>
      <span><svg width="26" height="12" viewBox="0 0 26 12"><line x1="1" y1="6" x2="25" y2="6" class="sl-arc sl-arc-main sl-arc-owed" /></svg> promised, never paid off</span>
    </div>
    <div class="sl-sort" role="group" aria-label="Sort rows">
      <span>Sort by</span>
      <button type="button" data-sort="start" aria-pressed="true">first mention</button>
      <button type="button" data-sort="end" aria-pressed="false">payoff</button>
      <button type="button" data-sort="length" aria-pressed="false">longest tension</button>
    </div>
  </div>

  <div class="sl-wrap">
    <svg
      id="storyline"
      class="sl-svg"
      viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
      data-row-h={ROW_H}
      data-header-h={HEADER_H}
      aria-labelledby="sl-title"
    >
      <title id="sl-title">Story line diagram of the book's major ideas</title>
      <g class="sl-parts">
        {parts.map((part, i) => {
          const label = fitLabel(part, shortTitle(part));
          return (
            <g>
              <rect class:list={["sl-part-band", { alt: i % 2 === 1 }]} x={x(part.start)} y={0} width={x(part.end) - x(part.start)} height={BAND_H} />
              {label && (
                <text class="sl-part-label" x={(x(part.start) + x(part.end)) / 2} y={BAND_H / 2} dy="0.35em" text-anchor="middle">{label}</text>
              )}
              <title>{part.title} · {words(part.end - part.start)} words</title>
            </g>
          );
        })}
      </g>

      <g class="sl-chapters">
        {chapters.map((chapter) => {
          const isPart = chapter.level === 1;
          const label = isPart ? null : fitLabel(chapter, shortTitle(chapter));
          return (
            <a href={`/#${chapter.slug}`} target="_blank" rel="noopener" class="sl-chapter">
              <rect class="sl-col" x={x(chapter.start)} y={HEADER_H} width={x(chapter.end) - x(chapter.start)} height={PLOT_H} />
              <rect class="sl-chap-band" x={x(chapter.start)} y={BAND_H + 2} width={x(chapter.end) - x(chapter.start)} height={BAND_H} />
              <line class="sl-chap-line" x1={x(chapter.start)} y1={isPart ? 0 : BAND_H + 2} x2={x(chapter.start)} y2={HEIGHT - PAD_B} />
              {label && (
                <text class="sl-chap-label" x={x(chapter.start) + 4} y={BAND_H + 2 + BAND_H / 2} dy="0.35em">{label}</text>
              )}
              <title>{chapter.title} · {words(chapter.end - chapter.start)} words · starts at {pct(chapter.start)}</title>
            </a>
          );
        })}
        <line class="sl-chap-line" x1={x(totalWords)} y1={0} x2={x(totalWords)} y2={HEIGHT - PAD_B} />
      </g>

      <g class="sl-rows">
        {rows.map(({ thread, y, dots }) => (
          <g
            class="sl-row"
            transform={`translate(0, ${y})`}
            data-start={thread.start}
            data-end={thread.end}
            data-length={thread.end - thread.start}
          >
            <rect class="sl-row-bg" x={0} y={-ROW_H / 2} width={WIDTH} height={ROW_H} />
            <text class="sl-label" x={LABEL_W - 12} y={0} dy="0.35em" text-anchor="end">
              {thread.title}
              <title>{thread.question}</title>
            </text>
            {thread.explainAt !== null && thread.explainAt > thread.start && (
              <line class="sl-arc sl-arc-pre" x1={x(thread.start)} y1={0} x2={x(thread.explainAt)} y2={0} />
            )}
            {thread.end > (thread.explainAt ?? thread.start) && (
              <line
                class:list={[
                  "sl-arc",
                  "sl-arc-main",
                  { "sl-arc-owed": thread.owed, "sl-arc-open": !thread.owed && thread.payoffAt === null },
                ]}
                x1={x(thread.explainAt ?? thread.start)}
                y1={0}
                x2={x(thread.end)}
                y2={0}
              />
            )}
            {thread.owed && thread.end === thread.start && (
              <line class="sl-arc sl-arc-main sl-arc-owed" x1={x(thread.start)} y1={0} x2={x(totalWords)} y2={0} />
            )}
            {dots.map(({ m, tip }) => (
              <a
                href={`/#${m.section.slug}`}
                target="_blank"
                rel="noopener"
                data-m={tip}
                aria-label={`${thread.title}: ${describe(m).toLowerCase()} in ${m.section.title}`}
                transform={`translate(${x(m.position)}, 0)`}
              >
                {m.kind === "payoff" ? (
                  <path class={dotClass(m)} d="M0,-5 L5,0 L0,5 L-5,0 Z" />
                ) : (
                  <circle class={dotClass(m)} r={m.kind === "explain" ? 4.4 : m.kind === "plant" ? 3.4 : 2.8} />
                )}
              </a>
            ))}
          </g>
        ))}
      </g>
    </svg>
  </div>

  <div class="sl-tip" id="sl-tip" hidden role="tooltip">
    <div class="sl-tip-head">
      <span class="sl-tip-kind" id="sl-tip-kind"></span>
      <span class="sl-tip-pos" id="sl-tip-pos"></span>
    </div>
    <div class="sl-tip-thread" id="sl-tip-thread"></div>
    <div class="sl-tip-section" id="sl-tip-section"></div>
    <blockquote class="sl-tip-quote" id="sl-tip-quote"></blockquote>
    <div class="sl-tip-note" id="sl-tip-note"></div>
  </div>

  <script type="application/json" id="sl-tips" set:html={JSON.stringify(tips)} />

  <div class="sl-findings">
    <div class="sl-finding">
      <h3>Used before it is explained <span class="sl-count">{earlyMentions.length}</span></h3>
      {earlyMentions.length === 0 ? (
        <p class="sl-empty">Nothing. Every idea is explained before the book leans on it.</p>
      ) : (
        <ul>
          {earlyMentions.map(({ thread, m }) => (
            <li>
              <strong>{thread.title}</strong> in <a href={`/#${m.section.slug}`} target="_blank" rel="noopener">{m.section.title}</a>
              <span class="sl-meta"> · explained in {explainedIn(thread)}, {words((thread.explainAt ?? 0) - m.position)} words later</span>
              <q>{m.quote}</q>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="sl-finding">
      <h3>Promised, never paid off <span class="sl-count">{owed.length}</span></h3>
      {owed.length === 0 ? (
        <p class="sl-empty">Nothing. Every planted idea gets its payoff.</p>
      ) : (
        <ul>
          {owed.map((t) => (
            <li>
              <strong>{t.title}</strong> planted in <a href={`/#${t.mentions[0]!.section.slug}`} target="_blank" rel="noopener">{t.mentions[0]!.section.title}</a>
              <span class="sl-note">{t.question}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="sl-finding">
      <h3>Explained cold, nothing planted first <span class="sl-count">{coldOpens.length}</span></h3>
      <p class="sl-empty">Fine for mechanics; a missed chance for anything the reader should have been curious about.</p>
      <ul>
        {coldOpens.map((t) => (
          <li>
            <strong>{t.title}</strong> arrives in <a href={`/#${t.mentions[0]!.section.slug}`} target="_blank" rel="noopener">{t.mentions[0]!.section.title}</a>
            <span class="sl-meta"> · {pct(t.start)} into the book</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <table class="sl-table">
    <thead>
      <tr>
        <th>Thread</th>
        <th>Opens</th>
        <th>Explained</th>
        <th>Payoff</th>
        <th class="sl-num">Tension</th>
      </tr>
    </thead>
    <tbody>
      {threads.map((t) => {
        const explain = mentionOf(t, "explain");
        const payoff = mentionOf(t, "payoff");
        return (
          <tr>
            <td><strong>{t.title}</strong><span class="sl-note">{t.question}</span></td>
            <td>{t.mentions[0]!.section.title}<span class="sl-meta">{pct(t.start)}</span></td>
            <td>{explain ? explain.section.title : payoff ? "with the payoff" : "—"}{explain && <span class="sl-meta">{pct(explain.position)}</span>}</td>
            <td class:list={{ "sl-red": t.owed }}>{payoff ? payoff.section.title : t.owed ? "never" : "—"}{payoff && <span class="sl-meta">{pct(payoff.position)}</span>}</td>
            <td class="sl-num">{words(t.end - t.start)}<span class="sl-meta">{pct(t.end - t.start)} of the book</span></td>
          </tr>
        );
      })}
    </tbody>
  </table>
</section>

<script>
  interface Tip {
    thread: string;
    label: string;
    early: boolean;
    section: string;
    quote: string;
    note: string;
    position: string;
  }

  const svg = document.getElementById("storyline");
  const tipEl = document.getElementById("sl-tip");
  const tipsJson = document.getElementById("sl-tips")?.textContent ?? "[]";
  const tips = JSON.parse(tipsJson) as Tip[];

  if (svg && tipEl) {
    const field = (id: string): HTMLElement => document.getElementById(id) as HTMLElement;
    const kindEl = field("sl-tip-kind");
    const posEl = field("sl-tip-pos");
    const threadEl = field("sl-tip-thread");
    const sectionEl = field("sl-tip-section");
    const quoteEl = field("sl-tip-quote");
    const noteEl = field("sl-tip-note");

    const place = (clientX: number, clientY: number): void => {
      const margin = 14;
      const rect = tipEl.getBoundingClientRect();
      let left = clientX + margin;
      let top = clientY + margin;
      if (left + rect.width > window.innerWidth - margin) left = clientX - rect.width - margin;
      if (top + rect.height > window.innerHeight - margin) top = clientY - rect.height - margin;
      tipEl.style.left = `${Math.max(margin, left)}px`;
      tipEl.style.top = `${Math.max(margin, top)}px`;
    };

    const dotOf = (target: EventTarget | null): SVGElement | null =>
      target instanceof Element ? target.closest<SVGElement>("[data-m]") : null;

    const show = (dot: SVGElement, clientX: number, clientY: number): void => {
      const tip = tips[Number(dot.dataset["m"])];
      if (!tip) return;
      kindEl.textContent = tip.label;
      kindEl.classList.toggle("sl-red", tip.early);
      posEl.textContent = tip.position;
      threadEl.textContent = tip.thread;
      sectionEl.textContent = tip.section;
      quoteEl.textContent = tip.quote;
      noteEl.textContent = tip.note;
      tipEl.hidden = false;
      place(clientX, clientY);
    };

    svg.addEventListener("mouseover", (event) => {
      const dot = dotOf(event.target);
      if (dot) show(dot, event.clientX, event.clientY);
    });
    svg.addEventListener("mousemove", (event) => {
      if (!tipEl.hidden) place(event.clientX, event.clientY);
    });
    svg.addEventListener("mouseout", (event) => {
      if (dotOf(event.target)) tipEl.hidden = true;
    });
    svg.addEventListener("focusin", (event) => {
      const dot = dotOf(event.target);
      if (!dot) return;
      const rect = dot.getBoundingClientRect();
      show(dot, rect.left + rect.width / 2, rect.bottom);
    });
    svg.addEventListener("focusout", (event) => {
      if (dotOf(event.target)) tipEl.hidden = true;
    });

    const rowH = Number(svg.dataset["rowH"]);
    const headerH = Number(svg.dataset["headerH"]);
    const rows = Array.from(svg.querySelectorAll<SVGGElement>(".sl-row"));
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".sl-sort button"));

    const sortRows = (key: string): void => {
      const value = (row: SVGGElement): number => Number(row.dataset[key]);
      const sorted = [...rows].sort((a, b) =>
        key === "length" ? value(b) - value(a) : value(a) - value(b),
      );
      sorted.forEach((row, i) => {
        row.setAttribute("transform", `translate(0, ${headerH + i * rowH + rowH / 2})`);
      });
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset["sort"] === key)));
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => sortRows(button.dataset["sort"] ?? "start"));
    });
  }
</script>

<style>
  .sl {
    --sl-red: oklch(56% 0.19 27);
  }

  @media (prefers-color-scheme: dark) {
    .sl {
      --sl-red: oklch(72% 0.17 27);
    }
  }

  .sl-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-bottom: 1rem;
  }

  .sl-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-secondary);
  }

  .sl-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sl-sort {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-muted);
  }

  .sl-sort span {
    margin-right: 0.35rem;
  }

  .sl-sort button {
    font: inherit;
    color: var(--ink-secondary);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .sl-sort button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .sl-sort button[aria-pressed="true"] {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  .sl-wrap {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 0.375rem;
    background: var(--paper);
  }

  .sl-svg {
    display: block;
    width: 100%;
    min-width: 64rem;
    font-family: var(--font-sans);
  }

  .sl-row-bg {
    fill: transparent;
    transition: fill 0.1s ease;
  }

  .sl-row:hover .sl-row-bg {
    fill: var(--paper-inset);
  }

  .sl-label {
    font-size: 11px;
    fill: var(--ink);
  }

  .sl-row:hover .sl-label {
    fill: var(--accent);
  }

  .sl-arc {
    fill: none;
    stroke-linecap: round;
  }

  .sl-arc-pre {
    stroke: var(--ink-muted);
    stroke-width: 1.2;
    stroke-dasharray: 2 3;
  }

  .sl-arc-main {
    stroke: var(--heading);
    stroke-width: 1.6;
  }

  .sl-arc-open {
    stroke-dasharray: 5 4;
    opacity: 0.45;
  }

  .sl-arc-owed {
    stroke: var(--sl-red);
    stroke-dasharray: 5 4;
    opacity: 0.7;
  }

  .sl-dot {
    cursor: pointer;
    transition: transform 0.1s ease;
  }

  .sl-plant {
    fill: var(--paper);
    stroke: var(--ink-secondary);
    stroke-width: 1.3;
  }

  .sl-use {
    fill: var(--ink-secondary);
  }

  .sl-explain {
    fill: var(--heading);
    stroke: var(--paper);
    stroke-width: 1.5;
  }

  .sl-payoff {
    fill: var(--accent);
  }

  .sl-after {
    fill: var(--paper);
    stroke: var(--ink-muted);
    stroke-width: 1.2;
  }

  .sl-early {
    fill: var(--sl-red);
    stroke: var(--sl-red);
    stroke-width: 1.3;
  }

  .sl-plant.sl-early {
    fill: var(--paper);
  }

  .sl-svg a:hover .sl-dot {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .sl-svg a:focus-visible .sl-dot {
    outline: none;
    stroke: var(--accent);
    stroke-width: 2.5;
  }

  .sl-part-band {
    fill: var(--paper-inset);
  }

  .sl-part-band.alt {
    fill: transparent;
  }

  .sl-part-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--ink-secondary);
  }

  .sl-chap-band {
    fill: transparent;
  }

  .sl-chap-label {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--ink-muted);
  }

  .sl-chap-line {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .sl-col {
    fill: var(--heading);
    opacity: 0;
    transition: opacity 0.12s ease;
  }

  .sl-chapter:hover .sl-col {
    opacity: 0.07;
  }

  .sl-chapter:hover .sl-chap-label {
    fill: var(--accent);
  }

  .sl-tip {
    position: fixed;
    z-index: 20;
    max-width: 24rem;
    padding: 0.75rem 0.9rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 0.375rem;
    box-shadow: 0 8px 24px -12px color-mix(in srgb, var(--ink) 45%, transparent);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-secondary);
    pointer-events: none;
  }

  .sl-tip-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .sl-tip-pos {
    color: var(--ink-muted);
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .sl-tip-thread {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
    font-size: 0.85rem;
  }

  .sl-tip-section {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-muted);

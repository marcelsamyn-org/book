---
import "../styles/global.css";

interface Props {
  lastUpdatedIso: string;
  lineChanges: string;
}

const { lastUpdatedIso, lineChanges } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sacred Struggle — Work in Progress</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Lora:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
</head>
<body class="font-sans text-ink bg-paper antialiased relative">
  <div
    class="pointer-events-none fixed inset-0 opacity-[0.025] mix-blend-multiply"
    aria-hidden="true"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"
  ></div>

  <div class="relative w-full border-b border-rule bg-paper-inset/60 text-ink-secondary font-sans text-center py-2 text-[0.6875rem] tracking-[0.18em] uppercase">
    <span class="inline-block size-1.5 rounded-full bg-accent mr-2 align-middle"></span>
    Work in progress
  </div>

  <div class="relative max-w-prose mx-auto px-6 py-16 max-md:px-5 max-md:py-10">
    <header class="mb-10">
      <h1 class="font-display text-5xl max-md:text-[2.5rem] text-heading font-semibold leading-[1.1] tracking-tight">Sacred Struggle</h1>
      <p class="text-ink-secondary font-display italic mt-4 text-lg leading-relaxed">
        Finding meaning and fulfillment in a world where AI makes everything too easy.
      </p>

      <a
        href="https://kalon.solutions/sacred-struggle/"
        class="preorder-link mt-6 group inline-flex items-center gap-2 rounded-full border border-orange-700/40 bg-orange-500 px-5 py-2.5 text-sm font-medium text-white shadow-[inset_0_1px_1px_var(--color-orange-300)/50%,inset_0_-1px_2px_var(--color-orange-800)/30%,0_4px_16px_var(--color-orange-500)/30%] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[inset_0_2px_2px_var(--color-orange-200)/60%,inset_0_-1px_2px_var(--color-orange-800)/30%,0_8px_24px_var(--color-orange-400)/40%]"
      >
        <span>Pre-order</span>
        <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5">→</span>
      </a>

      <details class="mt-8 group">
        <summary class="cursor-pointer list-none flex items-center gap-2 text-xs text-ink-muted hover:text-ink-secondary transition-colors">
          <span class="text-[10px] group-open:rotate-90 transition-transform duration-200">&#9654;</span>
          <span>Updated <span data-timestamp={lastUpdatedIso}></span></span>
          <span class="opacity-40">{lineChanges}</span>
        </summary>
        <div class="mt-4 pt-4 border-t border-rule">
          <slot name="commits" />
          <div class="mt-6 pt-4 border-t border-rule">
            <slot name="word-history" />
          </div>
        </div>
      </details>

      <details class="mt-6 group" open>
        <summary class="cursor-pointer list-none flex items-center gap-2 text-xs text-ink-muted hover:text-ink-secondary transition-colors">
          <span class="text-[10px] group-open:rotate-90 transition-transform duration-200">&#9654;</span>
          <span>Progress</span>
          <slot name="progress-summary" />
        </summary>
        <div class="mt-4 pt-4 border-t border-rule">
          <slot name="progress" />
        </div>
      </details>
    </header>

    <nav class="mb-16">
      <details class="group">
        <summary class="cursor-pointer list-none flex items-center gap-2 text-xs text-ink-muted hover:text-ink-secondary transition-colors">
          <span class="text-[10px] group-open:rotate-90 transition-transform duration-200">&#9654;</span>
          <span>Contents</span>
        </summary>
        <div class="mt-5 pt-5 border-t border-rule">
          <slot name="toc" />
        </div>
      </details>
    </nav>

    <main class="book-body font-mono">
      <slot />
    </main>
  </div>

  <script>
    function formatRelativeDate(date: Date): string {
      const now = new Date();
      const diffSec = Math.floor((now.getTime() - date.getTime()) / 1000);
      const units: Array<[number, Intl.RelativeTimeFormatUnit]> = [
        [60 * 60 * 24 * 365, "year"],
        [60 * 60 * 24 * 30, "month"],
        [60 * 60 * 24 * 7, "week"],
        [60 * 60 * 24, "day"],
        [60 * 60, "hour"],
        [60, "minute"],
      ];
      const formatter = new Intl.RelativeTimeFormat(undefined, { numeric: "auto" });
      for (const [secs, unit] of units) {
        const value = Math.floor(diffSec / secs);
        if (value > 0) return formatter.format(-value, unit);
      }
      return formatter.format(0, "second");
    }

    document.querySelectorAll<HTMLElement>("[data-timestamp]").forEach((el) => {
      const timestamp = el.dataset["timestamp"];
      if (timestamp) {
        el.textContent = formatRelativeDate(new Date(timestamp));
      }
    });

    document.querySelectorAll<HTMLAnchorElement>(".toc-link").forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.getAttribute("href")?.substring(1);
        if (targetId) {
          const target = document.getElementById(targetId);
          target?.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });
  </script>
</body>
</html>

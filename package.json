{
  "name": "book-research",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.2.23",
  "type": "module",
  "scripts": {
    "research:run": "bun run src/index.ts",
    "research:questions": "bun run src/tools/generate-questions.ts",
    "research:dashboard": "bun run src/tools/research-dashboard.tsx",
    "build:site": "astro build",
    "book:export": "bun run export/build.ts",
    "report:progress": "bun run src/publish/reportProgress.ts",
    "storyline:check": "bun run src/tools/storyline-check.ts",
    "dev:site": "astro dev",
    "preview": "astro preview",
    "netlify": "netlify",
    "video:studio": "remotion studio video/src/index.ts --public-dir=video/public",
    "video:render": "remotion render video/src/index.ts SacredStruggleBook output/video/sacred-struggle-book.mp4 --public-dir=video/public",
    "video:frames": "remotion still video/src/index.ts SacredStruggleBook --public-dir=video/public"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@opentui/core": "^0.1.25",
    "@opentui/core-darwin-arm64": "^0.1.25",
    "@opentui/solid": "^0.1.25",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.0.8",
    "openai": "^4.56.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "solid-js": "^1.9.9",
    "yoga-layout": "^3.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.525",
    "@types/bun": "^1.2.23",
    "@types/node": "^22.7.4",
    "netlify-cli": "^24.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.525",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.6.3"
  }
}
